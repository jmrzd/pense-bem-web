# Código de acesso à área administrativa (/dashboard).
# Isso é apenas uma trava simples no navegador, NÃO é autenticação real —
# qualquer pessoa pode ver o código no código-fonte do bundle. Sirva só para
# afastar visitantes casuais até existir login de verdade no backend.
VITE_ADMIN_CODE=troque-este-codigo

# URL base da API do backend (FastAPI). Em dev local, uvicorn roda em
# localhost:8000 por padrão (veja backend/README.md).
VITE_API_URL=http://localhost:8000
